# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (kept explicit by default)
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Additional ignores
.expo-shared/
.expo/cache/
.expo/web/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/
.idea/

# Python virtualenvs and caches
venv/
.venv/
**/__pycache__/
*.py[cod]

# Build outputs
build/
dist/

# Metro cache
.expo/metro-cache/

# Misc
coverage/
*.log

# NOTE: per your instruction, I did NOT add .env or other secret files to gitignore.
# If you later want to ignore them, add .env, .env.* or src/secrets.local.js here.
